# =============================================================================
# Unreal Engine 5 - .gitignore
# =============================================================================

# Visual Studio / Rider
.vs/
*.VC.db
*.VC.VC.opendb
*.sln
*.suo
*.user
*.sdf
*.opensdf
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.idea/

# Build folders
Binaries/
Build/

# Intermediate folders (regenerated by engine)
Intermediate/
DerivedDataCache/

# Saved folder (local caches, logs, crashes)
Saved/

# Platform-specific folders
Platforms/

# Debug and cache files
*.pdb
*.obj
*.lib
*.dll
*.exe
*.exp
*.log
*.tlog
*.ilk

# Shader cache
ShaderDebugInfo/

# Automation tool
.ue4dependencies

# Mac specific
*.DS_Store

# Linux specific
*.so

# Editor generated
*.VC.opendb
*.VC.db

# Large asset caches
**/DDC/

# Compiled assets (if needed to ignore)
# *.uasset
# *.umap

# Crash reports
CrashReportClient/
